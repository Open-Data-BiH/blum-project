---
// Import Leaflet styles with the component instead of from a CDN.
import 'leaflet/dist/leaflet.css';
import '../../styles/pages/_map-legend.scss';
import '../../styles/pages/_route-map.scss';
import { getPagePath, type Locale } from '../../lib/site-config';
import MapContainer from './MapContainer.astro';
import MapNote from './MapNote.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const mapPagePath = `${baseUrl}${getPagePath('map', locale).replace(/^\/+/, '')}`;
---

<section class="section section--wide" id="map">
  <div class="container">
    <h2 class="section__title" id="map-title">
      {locale === 'en' ? 'Interactive public transport map' : 'Interaktivna mapa gradskog prevoza'}
    </h2>

    <MapContainer
      mapId="map-container"
      label={locale === 'en' ? 'Interactive transport map' : 'Interaktivna mapa prevoza'}
      role="application"
      live="polite"
    >
      <noscript class="map-note">
        <i class="map-note__icon fas fa-info-circle" aria-hidden="true"></i>
        <div class="map-note__content">
          <p>
            {locale === 'en'
              ? 'JavaScript is required to display the interactive map. Enable JavaScript in your browser to view stops and lines.'
              : 'JavaScript je potreban za prikaz interaktivne mape. Omogućite JavaScript u pregledaču kako biste vidjeli stajališta i linije.'}
          </p>
        </div>
      </noscript>
    </MapContainer>

    <div class="map-section__actions">
      <a href={mapPagePath} class="btn btn--secondary btn--sm" id="home-map-full-link">
        <i class="fas fa-up-right-and-down-left-from-center" aria-hidden="true"></i>
        <span class="btn__label">
          {locale === 'en' ? 'Open map' : 'Otvori mapu'}
        </span>
      </a>
    </div>

    <MapNote id="bus-stops-note" className="map-note--info" showIcon={false}>
      <h3 class="map-note__title" id="map-note-title">{locale === 'en' ? 'About the interactive map' : 'O interaktivnoj mapi'}</h3>
      <p class="map-note__description" id="map-note-description">
        {locale === 'en'
          ? 'Map markers show key public transport points and other important city locations, including bus stops, the main bus station, railway stations, Nextbike stations, and the airport shuttle. New locations will be added gradually.'
          : 'Markeri na mapi prikazuju ključne tačke javnog prevoza i druge važne lokacije u gradu, uključujući autobuska stajališta, glavnu autobusku stanicu, željezničke stanice, Nextbike stanice i aerodromski transfer. Novi sadržaji i lokacije biće postepeno dodavani.'}
      </p>
      <div class="map-note__tips" aria-labelledby="map-note-tips-title">
        <p class="map-note__tips-title" id="map-note-tips-title">{locale === 'en' ? 'Tips:' : 'Savjeti:'}</p>
        <ul class="map-note__tips-list">
          <li id="map-note-tip-item-1">
            {locale === 'en'
              ? 'Click a marker to see the approximate walking time (radius about 5 minutes).'
              : 'Kliknite na marker da vidite približno vrijeme hodanja (radijus oko 5 min).'}
          </li>
          <li id="map-note-tip-item-2">
            {locale === 'en'
              ? 'Use the layer controls to show or hide specific location types on the map.'
              : 'Korištenjem kontrola za slojeve možete uključiti ili isključiti pojedine vrste lokacija na mapi.'}
          </li>
        </ul>
      </div>
    </MapNote>
  </div>
</section>

<script>
  const mapSection = document.getElementById('map');
  if (mapSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          import('../../scripts/features/map/main-map').then(({ initMainMap }) => {
            initMainMap();
          });
        }
      },
      { rootMargin: '300px' },
    );
    observer.observe(mapSection);
  }
</script>
