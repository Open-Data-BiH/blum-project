---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  addHashToPath,
  getAlternatePaths,
  getLocalizedMeta,
  getPagePath,
  getSwitchLocale,
  type Locale,
} from '../../lib/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string): string => `${baseUrl}${path.replace(/^\/+/, '')}`;
const meta = getLocalizedMeta('about', locale);
const alternatePaths = getAlternatePaths('about');
const linesPath = withBase(getPagePath('lines', locale));
const timetablePath = withBase(addHashToPath(getPagePath('lines', locale), 'timetable'));
const pricingPath = withBase(getPagePath('pricing', locale));
const airportPath = withBase(getPagePath('airport', locale));
const updatesPath = withBase(getPagePath('updates', locale));
const contactPath = withBase(getPagePath('contact', locale));
const isEnglish = locale === 'en';
---

<BaseLayout
  pageKey="about"
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={getPagePath('about', locale)}
  alternatePaths={alternatePaths}
  switchLanguagePath={getPagePath('about', getSwitchLocale(locale))}
>
  <section class="section section--narrow" id="about">
    <div class="container">
      <h1 class="section__title" id="about-title">{isEnglish ? 'About' : 'O projektu'}</h1>

      <div class="about-content">
        {isEnglish ? (
          <div>
            <h2>Why does BL Prevoz exist?</h2>
            <p>
              Public transport in Banja Luka is provided by multiple operators, and information about routes, timetables, and ticket prices is often scattered across different sources or difficult to find.
            </p>
            <p>
              BL Prevoz was created to bring that information together and make it accessible to everyone:
              simply, clearly, and free of charge. The platform's goal is to help every user quickly find
              what they need to move around the city.
            </p>

            <h2>From an initiative to a website</h2>
            <p>
              The initiative for better public transport in Banja Luka began in 2023. The BL Prevoz website
              has been online since 2025 as a practical continuation of that work and a place where useful
              public transport information can be found more easily.
            </p>
            <p>
              The initiative also addresses concrete problems through written submissions and work with the City's
              municipal services department and inspection authorities. The aim is to draw attention to problems
              passengers face and contribute to improving the quality of public transport.
            </p>
            <p>
              Public transport is also part of the broader topic of sustainable urban mobility. The{' '}
              <a
                href="https://czzs.org/en/multimedia/publications/publikacije-transport/"
                target="_blank"
                rel="noopener noreferrer"
              >Center for Environment</a>{' '}
              in Banja Luka has worked on this topic for years through research and publications on transport,
              as well as by encouraging citizens to take part in decision-making.
            </p>

            <h2>What can you do on BL Prevoz?</h2>
            <div class="about-features">
              <a href={linesPath} class="about-feature">
                <i class="fa-solid fa-route" aria-hidden="true"></i>
                <span>View bus lines and routes</span>
              </a>
              <a href={timetablePath} class="about-feature">
                <i class="fa-solid fa-clock" aria-hidden="true"></i>
                <span>Check timetables</span>
              </a>
              <a href={pricingPath} class="about-feature">
                <i class="fa-solid fa-ticket" aria-hidden="true"></i>
                <span>View ticket prices</span>
              </a>
              <a href={airportPath} class="about-feature">
                <i class="fa-solid fa-plane-departure" aria-hidden="true"></i>
                <span>Airport transport information</span>
              </a>
              <a href={updatesPath} class="about-feature">
                <i class="fa-solid fa-bell" aria-hidden="true"></i>
                <span>Follow transport updates</span>
              </a>
            </div>

            <h2>An independent project</h2>
            <p>
              BL Prevoz is <strong>not an official website</strong> of the City of Banja Luka, any transport operator, or any institution.
              It is an independent, volunteer-driven platform with no commercial backing and no affiliation with any transport company or public authority.
            </p>
            <p>
              The website is free to use and continues to be developed as part of a broader, likewise independent open data initiative in Bosnia and Herzegovina,
              which is not affiliated with government institutions, transport operators, or any organization.
            </p>

            <h2>Where does the information come from?</h2>
            <p>
              All information on the platform is gathered from:
            </p>
            <ul class="about-sources-list">
              <li>publicly available data and documents</li>
              <li>official announcements from the City of Banja Luka and transport operators</li>
              <li>other relevant sources, such as specialist publications, websites, and forums, after additional verification</li>
            </ul>
            <p>
              We present information in a way that is useful for the public. We aim to keep it accurate and up to date,
              but we still recommend checking with operators for the latest changes.
            </p>

            <h2>Open data</h2>
            <p>
              BL Prevoz is guided by open data principles. Public transport information serves the public interest and should be freely available to everyone.
            </p>
            <p>
              The source code of this project is publicly available, and the data shown on the site may be freely used for informational purposes.
              We hope this approach can encourage similar open data initiatives in our city and beyond.
            </p>

            <h2>Future plans</h2>
            <p>
              The platform will continue to develop in line with available data and the needs of its users. Plans include:
            </p>
            <ul class="about-sources-list">
              <li>continuously improving the information and features available on the platform</li>
              <li>making public transport information easier to use for tourists and first-time visitors to the city</li>
              <li>expanding information about other modes of transport</li>
              <li>showing vehicle locations in real time if the City makes GPS tracking data available through a public API</li>
            </ul>

            <div class="about-cta">
              <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
              <div>
                <strong>Noticed an error or have a suggestion?</strong>
                <p>
                  Help keep the information as accurate and useful as possible.
                  If you've noticed incorrect data or have a suggestion,
                  <a href={contactPath}>get in touch</a>.
                </p>
              </div>
            </div>
          </div>
        ) : (
          <div>
          <h2>Zašto BL Prevoz postoji?</h2>
          <p>
            U Banjoj Luci javni prevoz obavlja više prevoznika, a informacije o linijama, redovima vožnje i cijenama karata često su raspoređene na različitim mjestima ili ih nije lako pronaći.
          </p>
          <p>
            BL Prevoz je nastao iz potrebe da se te informacije objedine i učine dostupnim svima:
            jednostavno, pregledno i besplatno. Cilj platforme je da svaki korisnik brzo pronađe
            ono što mu je potrebno za kretanje gradom.
          </p>

          <h2>Od inicijative do stranice</h2>
          <p>
            Inicijativa za bolji gradski prevoz u Banjoj Luci pokrenuta je 2023. godine. Stranica BL Prevoz
            postoji od 2025. godine kao praktičan nastavak tog rada i mjesto na kojem se lakše mogu pronaći
            korisne informacije o gradskom prevozu.
          </p>
          <p>
            Inicijativa se konkretnim problemima bavi kroz dopise i rad s gradskom komunalnom službom i
            inspekcijskim organima. Cilj je ukazati na probleme s kojima se putnici susreću i doprinijeti
            podizanju kvaliteta gradskog prevoza.
          </p>
          <p>
            Gradski prevoz dio je šire teme održive urbane mobilnosti. Tom temom se u Banjoj Luci godinama
            bavi i{' '}<a
              href="https://czzs.org/multimedia/publikacije/publikacije-transport/"
              target="_blank"
              rel="noopener noreferrer"
            >Centar za životnu sredinu</a>, između ostalog kroz istraživanja i publikacije o saobraćaju te
            podsticanje građana da učestvuju u donošenju odluka.
          </p>

          <h2>Šta možete uraditi na BL Prevozu?</h2>
          <div class="about-features">
            <a href={linesPath} class="about-feature">
              <i class="fa-solid fa-route" aria-hidden="true"></i>
              <span>Pregledajte autobuske linije i rute</span>
            </a>
            <a href={timetablePath} class="about-feature">
              <i class="fa-solid fa-clock" aria-hidden="true"></i>
              <span>Provjerite red vožnje</span>
            </a>
            <a href={pricingPath} class="about-feature">
              <i class="fa-solid fa-ticket" aria-hidden="true"></i>
              <span>Pogledajte cijene karata</span>
            </a>
            <a href={airportPath} class="about-feature">
              <i class="fa-solid fa-plane-departure" aria-hidden="true"></i>
              <span>Informacije o aerodromskom transferu</span>
            </a>
            <a href={updatesPath} class="about-feature">
              <i class="fa-solid fa-bell" aria-hidden="true"></i>
              <span>Pratite obavještenja o izmjenama</span>
            </a>
          </div>

          <h2>Nezavisan projekat</h2>
          <p>
            BL Prevoz <strong>nije zvanična stranica</strong> Grada Banje Luke, prevoznika niti bilo koje institucije.
            Riječ je o nezavisnoj, volonterski vođenoj platformi koja nema komercijalnu pozadinu i ne zastupa interese nijednog prevoznika.
          </p>
          <p>
            Stranica je besplatna za korištenje i razvija se kao dio šire, takođe nezavisne inicijative otvorenih podataka u Bosni i Hercegovini,
            koja nije povezana s državnim ili lokalnim institucijama, prevoznicima niti drugim organizacijama.
          </p>

          <h2>Odakle dolaze informacije?</h2>
          <p>
            Sve informacije na platformi prikupljene su iz:
          </p>
          <ul class="about-sources-list">
            <li>javno dostupnih podataka i dokumenata</li>
            <li>zvaničnih obavještenja Grada Banje Luke i prevoznika</li>
            <li>drugih relevantnih izvora, poput stručnih publikacija, portala i foruma, nakon dodatne provjere</li>
          </ul>
          <p>
            Podatke prikazujemo tako da budu što pregledniji i korisniji. Nastojimo da budu tačni i ažurni,
            ali za najnovije izmjene uvijek preporučujemo dodatnu provjeru kod prevoznika.
          </p>

          <h2>Otvoreni podaci</h2>
          <p>
            BL Prevoz se zasniva na principima otvorenih podataka. Podaci o javnom prevozu od javnog su interesa i trebalo bi da budu slobodno dostupni svima.
          </p>
          <p>
            Izvorni kod ovog projekta je javno dostupan, a podaci prikazani na stranici mogu se slobodno koristiti u informativne svrhe.
            Nadamo se da ovaj pristup može podstaći i druge inicijative otvorenih podataka u našem gradu i šire.
          </p>

          <h2>Budući planovi</h2>
          <p>
            Platforma će se nastaviti razvijati u skladu s dostupnim podacima i potrebama korisnika. Planovi uključuju:
          </p>
          <ul class="about-sources-list">
            <li>kontinuirano unapređivanje informacija i funkcionalnosti platforme</li>
            <li>prilagođavanje informacija turistima i osobama koje prvi put koriste gradski prevoz u Banjoj Luci</li>
            <li>proširenje informacija o drugim vidovima prevoza</li>
            <li>prikaz lokacija vozila u realnom vremenu, ako Grad omogući pristup podacima GPS praćenja putem javno dostupnog API-ja</li>
          </ul>

          <div class="about-cta">
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
            <div>
              <strong>Primijetili ste grešku ili imate prijedlog?</strong>
              <p>
                Pomozite da informacije budu što tačnije i korisnije.
                Ako ste primijetili netačan podatak ili imate prijedlog za poboljšanje,
                <a href={contactPath}>javite nam se</a>.
              </p>
            </div>
          </div>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
