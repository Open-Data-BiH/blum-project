---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AirportMap from '../../components/AirportMap.astro';
import PageIntro from '../../components/PageIntro.astro';
import {
  getAlternatePaths,
  getLocalizedMeta,
  getPagePath,
  getSwitchLocale,
  type Locale,
} from '../../lib/site-config';
import '@fortawesome/fontawesome-free/css/brands.min.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string): string => `${baseUrl}${path.replace(/^\/+/, '')}`;

const airportFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: locale === 'en'
    ? [
        {
          '@type': 'Question',
          name: 'How do I get from Banja Luka Airport to the city center?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Take the Smiljić shuttle bus for 12 BAM (€6; euro payments are accepted), or a taxi for 40-60 BAM. The shuttle journey takes 30-45 minutes, waits outside the terminal after each flight arrival, and ends at the Old and Main Bus Station.',
          },
        },
        {
          '@type': 'Question',
          name: 'How much does the Banja Luka airport bus cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Smiljić airport shuttle costs 12 BAM one way. Tickets are purchased on the bus, where payment in euros is also accepted (€6).',
          },
        },
        {
          '@type': 'Question',
          name: 'How far is Banja Luka Airport from the city center?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Banja Luka Airport (BNX) is located in Mahovljani, approximately 25 km north of the city center via the E661 motorway.',
          },
        },
      ]
    : [
        {
          '@type': 'Question',
          name: 'Kako doći od aerodroma Banja Luka do centra grada?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Shuttle autobusom kompanije Smiljić za 12 KM (6 €; plaćanje u eurima je moguće), ili taksijem za 40-60 KM. Vožnja shuttle autobusom traje 30-45 minuta, autobus čeka ispred terminala nakon svakog leta i završava na Staroj i Glavnoj autobuskoj stanici.',
          },
        },
        {
          '@type': 'Question',
          name: 'Koliko kosta shuttle autobus od aerodroma Banja Luka?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Shuttle autobus kompanije Smiljić košta 12 KM u jednom pravcu. Karte se kupuju u autobusu, gdje je moguće platiti i 6 €.',
          },
        },
        {
          '@type': 'Question',
          name: 'Koliko je daleko aerodrom Banja Luka od centra?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Aerodrom Banja Luka (BNX) nalazi se u Mahovljanima, oko 25 km sjeverno od centra grada, autoputem E661.',
          },
        },
      ],
};

const airportShuttleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BusTrip',
  name: locale === 'en' ? 'Banja Luka Airport Shuttle (Smiljić)' : 'Shuttle prevoz do Aerodroma Banja Luka (Smiljić)',
  description:
    locale === 'en'
      ? 'Airport shuttle bus connecting Banja Luka city center to Banja Luka International Airport (BNX). Operated by Smiljić company.'
      : 'Shuttle autobus koji povezuje centar Banje Luke sa Međunarodnim aerodromom Banja Luka (BNX). Prevoznik je kompanija Smiljić.',
  provider: {
    '@type': 'Organization',
    name: 'Smiljić',
    url: 'https://smiljiccompany.ba/avio-transferi/',
  },
  departureStop: {
    '@type': 'BusStation',
    name: locale === 'en' ? 'Old and Main Bus Station Banja Luka' : 'Stara i Glavna autobuska stanica Banja Luka',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Banja Luka',
      addressCountry: 'BA',
    },
  },
  arrivalStop: {
    '@type': 'Airport',
    name: locale === 'en' ? 'Banja Luka Airport' : 'Aerodrom Banja Luka',
    iataCode: 'BNX',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Mahovljani bb',
      addressLocality: 'Banja Luka',
      addressCountry: 'BA',
    },
  },
};
const meta = getLocalizedMeta('airport', locale);
const alternatePaths = getAlternatePaths('airport');
const linesPath = withBase(getPagePath('lines', locale));
const mapPath = withBase(getPagePath('map', locale));
const pricingPath = withBase(getPagePath('pricing', locale));
const isEnglish = locale === 'en';
const t = (bhs: string, en: string): string => (isEnglish ? en : bhs);
---

<BaseLayout
  pageKey="airport"
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={getPagePath('airport', locale)}
  alternatePaths={alternatePaths}
  switchLanguagePath={getPagePath('airport', getSwitchLocale(locale))}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(airportFaqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(airportShuttleSchema)} />

  <PageIntro
    title={t('Prevoz do Aerodroma Banja Luka', 'Getting to Banja Luka Airport')}
    description={t(
      'Shuttle autobus, taksi, parking i druge informacije za planiranje dolaska ili odlaska.',
      'Shuttle bus, taxi, parking, and other information for planning your arrival or departure.',
    )}
    titleId="airport-title"
    icon="fa-solid fa-plane-departure"
    variant="airport"
  />

  <section class="section airport-journey" id="airport-journey">
    <div class="container">
      <div class="direction-heading">
        <div class="airport-journey-badge" aria-label={t('Veza aerodroma i grada', 'Airport and city connection')}>
          <span class="airport-journey-badge__point airport-journey-badge__point--airport">
            <i class="fa-solid fa-plane-departure" aria-hidden="true"></i>
            <span>{t('Aerodrom', 'Airport')}</span>
          </span>
          <span class="airport-journey-badge__route" aria-hidden="true">
            <i class="fa-solid fa-van-shuttle"></i>
          </span>
          <span class="airport-journey-badge__point airport-journey-badge__point--city">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span>{t('Grad', 'City')}</span>
          </span>
        </div>
        <h2 class="section__title airport-section-title">{t('Prevoz između aerodroma i grada', 'Travel between the airport and city')}</h2>
        <p class="direction-heading__subtitle">
          {t(
            'Iste opcije prevoza dostupne su u oba smjera. Ovdje su najvažnije informacije za izbor i planiranje puta.',
            'The same transport options are available in both directions. Here is what you need to choose and plan your journey.',
          )}
        </p>
      </div>

      <div class="airport-route-facts" aria-label={t('Osnovne informacije o aerodromu', 'Airport quick facts')}>
        <div class="airport-route-fact">
          <i class="fa-solid fa-plane" aria-hidden="true"></i>
          <span>
            <small>{t('Oznaka aerodroma', 'Airport code')}</small>
            <strong>BNX</strong>
          </span>
        </div>
        <div class="airport-route-fact">
          <i class="fa-solid fa-road" aria-hidden="true"></i>
          <span>
            <small>{t('Udaljenost od centra', 'Distance from center')}</small>
            <strong>~25 km</strong>
          </span>
        </div>
        <div class="airport-route-fact">
          <i class="fa-solid fa-route" aria-hidden="true"></i>
          <span>
            <small>{t('Najbrži pristup', 'Fastest access')}</small>
            <strong>{t('Autoput E661', 'E661 motorway')}</strong>
          </span>
        </div>
      </div>

      <div class="transport-options-grid">
        <article class="transport-option-card">
          <div class="transport-option-card__header">
            <div class="transport-option-card__icon" aria-hidden="true">
              <i class="fa-solid fa-bus"></i>
            </div>
            <h3>{t('Shuttle autobus (Smiljić)', 'Shuttle bus (Smiljić)')}</h3>
          </div>
          <p class="transport-option-card__summary">{t('12 KM (6 €) · 30-45 min', '12 BAM (€6) · 30-45 min')}</p>
          <ul class="transport-option-card__details">
            <li>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{t('Povezuje aerodrom sa Starom i Glavnom autobuskom stanicom', 'Connects the airport with the Old and Main Bus Stations')}</span>
            </li>
            <li>
              <i class="fa-solid fa-plane-arrival" aria-hidden="true"></i>
              <span>{t('Na aerodromu čeka ispred terminala nakon dolaska leta', 'At the airport, it waits outside the terminal after flight arrivals')}</span>
            </li>
            <li>
              <i class="fa-solid fa-plane-departure" aria-hidden="true"></i>
              <span>{t('Polasci iz grada usklađeni su sa redom letenja; dođite 15 min ranije', 'Departures from the city follow the flight schedule; arrive 15 min early')}</span>
            </li>
          </ul>
        </article>

        <article class="transport-option-card">
          <div class="transport-option-card__header">
            <div class="transport-option-card__icon" aria-hidden="true">
              <i class="fa-solid fa-taxi"></i>
            </div>
            <h3>{t('Taksi', 'Taxi')}</h3>
          </div>
          <p class="transport-option-card__summary">~40-60 KM · 30-35 min</p>
          <ul class="transport-option-card__details">
            <li>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{t('Dostupan ispred terminala ili uz preuzimanje na adresi u gradu', 'Available outside the terminal or with pickup from your city address')}</span>
            </li>
            <li>
              <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
              <span>{t('Dogovorite cijenu prije vožnje i rezervišite unaprijed kada idete na aerodrom', 'Agree on the fare before the ride and book ahead when travelling to the airport')}</span>
            </li>
            <li>
              <i class="fa-solid fa-list" aria-hidden="true"></i>
              <span>
                <a
                  href="https://www.banjaluka.rs.ba/gradjani/taksi-prevoz/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t('Spisak taksi prevoznika', 'List of city taxi operators')}
                  <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                </a>
              </span>
            </li>
          </ul>
        </article>

        <article class="transport-option-card">
          <div class="transport-option-card__header">
            <div class="transport-option-card__icon" aria-hidden="true">
              <i class="fa-solid fa-car"></i>
            </div>
            <h3>{t('Automobil', 'Car')}</h3>
          </div>
          <p class="transport-option-card__summary">30-35 min</p>
          <ul class="transport-option-card__details">
            <li>
              <i class="fa-solid fa-key" aria-hidden="true"></i>
              <span>{t('Rent-a-car je dostupan na aerodromu; preporučuje se rezervacija unaprijed', 'Car rental is available at the airport; advance booking is recommended')}</span>
            </li>
            <li>
              <i class="fa-solid fa-square-parking" aria-hidden="true"></i>
              {isEnglish ? (
                <span>Travelling in your own car? See <a href="#airport-parking">airport parking details</a>.</span>
              ) : (
                <span>Putujete sopstvenim automobilom? Pogledajte <a href="#airport-parking">detalje parkinga na aerodromu</a>.</span>
              )}
            </li>
          </ul>
        </article>
      </div>

      <div class="airport-tip">
        <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
        <p>
          {isEnglish ? (
            <span><strong>Tip:</strong> Many hotels in Banja Luka can arrange airport transfers for guests. Ask at reception.</span>
          ) : (
            <span><strong>Savjet:</strong> Mnogi hoteli u Banjoj Luci mogu organizovati transfer do aerodroma za goste. Raspitajte se na recepciji.</span>
          )}
        </p>
      </div>
    </div>
  </section>

  <section class="section section--wide" id="airport">
    <div class="container">
      <h2 class="section__title airport-section-title" id="airport-shuttle-title">{t('Aerodromski shuttle autobus', 'Airport Shuttle Bus')}</h2>
      <AirportMap locale={locale} />
    </div>
  </section>

  <section class="section" id="airport-parking">
    <div class="container">
      <h2 class="section__title airport-section-title">{t('Parking na aerodromu', 'Airport Parking')}</h2>
      <div class="airport-content-block">
        <p>
          {isEnglish ? (
            <span>
              Banja Luka Airport uses an automated parking payment system with license plate
              recognition. Payment is available via SMS, at the payment terminal inside the
              airport building, or through the <strong>GoParking mobile app</strong>.
            </span>
          ) : (
            <span>
              Aerodrom Banja Luka koristi automatizovani sistem naplate parkinga sa prepoznavanjem
              registarskih tablica. Plaćanje je moguće putem SMS-a, na terminalu za naplatu u
              zgradi aerodroma, ili putem <strong>GoParking mobilne aplikacije</strong>.
            </span>
          )}
        </p>

        <div class="parking-prices">
          <h3 class="parking-prices__title">
            <i class="fa-solid fa-square-parking" aria-hidden="true"></i>
            {t('Cjenovnik parkinga', 'Parking Prices')}
          </h3>
          <div class="parking-prices__grid">
            <div class="parking-price-item">
              <span class="parking-price-item__label">{t('Prvi sat', 'First hour')}</span>
              <span class="parking-price-item__value">3 KM</span>
            </div>
            <div class="parking-price-item">
              <span class="parking-price-item__label">{t('Prvih 24 sata', 'First 24 hours')}</span>
              <span class="parking-price-item__value">5 KM</span>
            </div>
            <div class="parking-price-item">
              <span class="parking-price-item__label">{t('Svaki sljedeći započeti dan', 'Each subsequent started day')}</span>
              <span class="parking-price-item__value">5 KM</span>
            </div>
          </div>
        </div>

        <div class="goparking-box" id="goparking">
          <div class="goparking-box__header">
            <img
              src={withBase('/assets/images/goparking-aero.webp')}
              alt=""
              class="goparking-box__logo"
              width={144}
              height={144}
              loading="lazy"
              decoding="async"
            />
            <h3>{t('Platite parking putem GoParking aplikacije', 'Pay for parking via GoParking app')}</h3>
          </div>
          <p>
            {t(
              'Skenirajte QR kod sa tiketa ili unesite broj karte, izaberite način plaćanja (SMS ili bankovna kartica) - jednostavno, brzo i sigurno.',
              'Scan the QR code from your ticket or enter the card number, choose payment method (SMS or bank card) - simple, fast and secure.',
            )}
          </p>
          <div class="goparking-box__stores">
            <a
              href="https://play.google.com/store/apps/details?id=com.goparking.airport&hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="goparking-store-badge"
            >
              <i class="fa-brands fa-google-play" aria-hidden="true"></i>
              Google Play
            </a>
            <a
              href="https://apps.apple.com/ba/app/goparking-aerodromi-rs/id6746559109"
              target="_blank"
              rel="noopener noreferrer"
              class="goparking-store-badge"
            >
              <i class="fa-brands fa-apple" aria-hidden="true"></i>
              App Store
            </a>
          </div>
        </div>

        <div class="airport-tip">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          <p>
            {isEnglish ? (
              <span>
                Check the current detailed parking price list on the{' '}
                <a href="https://bnx.aero/en/home/" target="_blank" rel="noopener noreferrer">official airport website</a>{' '}
                or in the GoParking app.
              </span>
            ) : (
              <span>
                Aktuelni detaljan cjenovnik parking usluga provjerite na{' '}
                <a href="https://bnx.aero/" target="_blank" rel="noopener noreferrer">službenoj stranici aerodroma</a>{' '}
                ili u GoParking aplikaciji.
              </span>
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="airport-continue">
    <div class="container">
      <h2 class="section__title airport-section-title">{t('Nastavite putovanje javnim prevozom', 'Continue your journey by public transport')}</h2>
      <p class="airport-intro" style="margin-bottom: var(--space-5);">
        {t('Nakon dolaska u Banju Luku, možete nastaviti putovanje gradskim autobuskim linijama.', 'After arriving in Banja Luka, you can continue your journey using city bus lines.')}
      </p>
      <div class="airport-links-grid">
        <a href={linesPath} class="airport-link-card">
          <i class="fa-solid fa-route" aria-hidden="true"></i>
          <div>
            <strong>{t('Autobuske linije i red vožnje', 'Bus lines and timetables')}</strong>
            <span class="airport-link-card__desc">{t('Gradske linije, trase i polasci', 'City bus lines, routes, and departures')}</span>
          </div>
        </a>
        <a href={mapPath} class="airport-link-card">
          <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
          <div>
            <strong>{t('Mapa stajališta', 'Bus stop map')}</strong>
            <span class="airport-link-card__desc">{t('Autobuska stajališta i linije koje ih koriste', 'Bus stops and the routes serving them')}</span>
          </div>
        </a>
        <a href={pricingPath} class="airport-link-card">
          <i class="fa-solid fa-ticket" aria-hidden="true"></i>
          <div>
            <strong>{t('Cijene karata', 'Ticket prices')}</strong>
            <span class="airport-link-card__desc">{t('Cjenovnik javnog prevoza', 'Public transport pricing')}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div class="container">
    <p class="airport-last-updated">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      {t('Informacije posljednji put provjerene: septembar 2026.', 'Information last reviewed: September 2026.')}
    </p>
  </div>
</BaseLayout>
