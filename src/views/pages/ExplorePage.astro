---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {
  getAlternatePaths,
  getLineDetailPath,
  getLocalizedMeta,
  getPagePath,
  getSwitchLocale,
  type Locale,
} from '../../lib/site-config';
import '../../styles/pages/_explore.scss';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';
const t = (bhs: string, en: string): string => (isEnglish ? en : bhs);
const meta = getLocalizedMeta('explore', locale);
const alternatePaths = getAlternatePaths('explore');
const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string): string => `${baseUrl}${path.replace(/^\/+/, '')}`;

const linePath = (lineId: string): string => withBase(getLineDetailPath(locale, lineId));
const mapPath = withBase(getPagePath('map', locale));
const guidePath = withBase(getPagePath('guide', locale));
const pricingPath = withBase(getPagePath('pricing', locale));
const banjBusUrl = isEnglish
  ? 'https://banjaluka.travel/eng/listing/banj-bus/'
  : 'https://banjaluka.travel/bih/listing/banj-bus/';

const universityUrl = 'https://www.unibl.org/en/university/about-the-university';

// One pictogram per destination, used by both the pills and the card toplines so the two
// cannot drift apart.
const destinationIcons = {
  trapisti: 'fa-church',
  vrucica: 'fa-umbrella-beach',
  ada: 'fa-utensils',
  banjBrdo: 'fa-monument',
  kampus: 'fa-graduation-cap',
} as const;

// The badge names the destination; the line numbers sit under it because Banj brdo has no
// number at all and Kampus is served by several.
const destinationPills = [
  { icon: destinationIcons.trapisti, label: t('Trapisti', 'Trapisti'), service: t('Linija 1', 'Line 1') },
  { icon: destinationIcons.vrucica, label: t('Vrućica', 'Vrućica'), service: t('Linija 9', 'Line 9') },
  { icon: destinationIcons.ada, label: t('Stara Ada', 'Stara Ada'), service: t('Linija 20', 'Line 20') },
  { icon: destinationIcons.banjBrdo, label: t('Banj brdo', 'Banj Hill'), service: 'Banj Bus' },
  {
    icon: destinationIcons.kampus,
    label: t('Kampus', 'Campus'),
    service: t('Linije 20, 14B, 14, 9B', 'Lines 20, 14B, 14, 9B'),
  },
];

interface TrapistiPlace {
  label: string;
  note: string;
  href?: string;
}

const trapistiPlaces: TrapistiPlace[] = [
  {
    label: t('Samostan Marija Zvijezda', 'Marija Zvijezda Monastery'),
    note: t(
      'Crkva i samostan po kojima je naselje dobilo ime - i mjesto gdje je nastao trapist sir.',
      'The church and monastery that gave the neighbourhood its name - and where Trappist cheese was first made.',
    ),
    href: 'https://www.biskupija-banjaluka.org/vijesti-2018-godina/marija-zvijezda-i-trapisti/',
  },
  {
    label: t('Trim staza u Trapistima', 'Trapisti fitness trail'),
    note: t(
      'Staza uz Vrbas za šetnju ili trčanje, s nastavkom prema Banji Slatini.',
      'A walking and running trail beside the Vrbas, continuing towards Banja Slatina.',
    ),
  },
  {
    label: t('Stara hidrocentrala', 'Old hydroelectric plant'),
    note: t(
      'Nekadašnja hidrocentrala uz Vrbas, danas tehnički spomenik iz vremena kada je grad dobijao struju.',
      'A former power station on the Vrbas - a technical landmark from the city’s early days of electricity.',
    ),
    href: 'https://sr.wikipedia.org/wiki/Стара_хидроцентрала_у_Делибашином_селу',
  },
  {
    label: t('Banjalučka pivara', 'Banja Luka Brewery'),
    note: t(
      'Trapisti su je osnovali 1873. godine; pivara i danas radi na istom mjestu.',
      'Founded by the Trappists in 1873, the brewery still operates on the same site.',
    ),
    href: 'https://www.banjaluckapivara.com/',
  },
];

// Every photograph on this page is third-party material and must stay credited next to it.
const credit = (source: string): string => `${t('Foto', 'Photo')}: ${source}`;
---

<BaseLayout
  pageKey="explore"
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={getPagePath('explore', locale)}
  alternatePaths={alternatePaths}
  switchLanguagePath={getPagePath('explore', getSwitchLocale(locale))}
>
  <PageIntro
    title={t('Banja Luka autobusom', 'Banja Luka by bus')}
    description={t(
      'Sjednite na autobus i dođite do rijeke, šume, šetnice ili mjesta za kafu - bez traženja parkinga.',
      'Take the bus to the river, the woods, a riverside walk or a good coffee - no parking required.',
    )}
    titleId="explore-title"
    icon="fa-solid fa-compass"
    variant="transit"
  />

  <section class="section explore-lead" aria-labelledby="explore-start-title">
    <div class="container explore-lead__grid">
      <figure class="explore-lead__photo">
        <img
          src={withBase('/assets/images/tourism/banja-luka-view.jpg')}
          alt={t(
            'Spomenik palim borcima na Banj brdu, sa pogledom na Banju Luku i dolinu Vrbasa',
            'The memorial on Banj Hill, overlooking Banja Luka and the Vrbas valley',
          )}
          width={1335}
          height={751}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="explore-credit">{credit('Tomas Damjanović')}</figcaption>
      </figure>

      <div class="explore-lead__content">
        <p class="explore-eyebrow">{t('Ideja za slobodan dan', 'For a free afternoon')}</p>
        <h2 id="explore-start-title">{t('Pet mjesta do kojih vodi autobus', 'Five places the bus can take you')}</h2>
        <p>
          {t(
            'Ovdje su izleti koji stanu u jedno popodne. Odaberite odredište, provjerite smjer i red vožnje, pa krenite. Za Banj brdo umjesto gradske linije vozi Banj Bus.',
            'These are outings that fit into an afternoon. Choose a destination, check the direction and timetable, then head out. Banj Hill is served by Banj Bus rather than a city line.',
          )}
        </p>
        <ul class="explore-route-pills" aria-label={t('Preporučena odredišta', 'Suggested destinations')}>
          {destinationPills.map((pill) => (
            <li class="explore-route-pill">
              <i class:list={['fa-solid', pill.icon]} aria-hidden="true"></i>
              <span class="explore-route-pill__text">
                <strong>{pill.label}</strong>
                <small>{pill.service}</small>
              </span>
            </li>
          ))}
        </ul>
        <a href={mapPath} class="explore-primary-link">
          <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
          {t('Otvori mapu', 'Open the map')}
        </a>
      </div>
    </div>
  </section>

  <section class="section explore-destinations" aria-labelledby="destinations-title">
    <div class="container">
      <div class="explore-section-heading">
        <p class="explore-eyebrow">{t('Kuda na pauzu', 'Where to take a break')}</p>
        <h2 id="destinations-title">{t('Pet prijedloga, s konkretnim polaskom', 'Five ideas, with the practical bus details')}</h2>
        <p>{t('Smjerovi i stajališta u nastavku računaju na polazak iz centra grada.', 'The directions and stops below assume you are leaving from the city centre.')}</p>
      </div>

      <div class="destination-grid">
        <article class="destination-card destination-card--wide">
          <figure class="destination-card__media">
            <img
              src={withBase('/assets/images/tourism/trapisti-marija-zvijezda.jpg')}
              alt={t('Samostan Marija Zvijezda u Trapistima', 'Marija Zvijezda Monastery in Trapisti')}
              width={1760}
              height={962}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="explore-credit">{credit('biskupija-banjaluka.org')}</figcaption>
          </figure>
          <div class="destination-card__body">
            <div class="destination-card__topline">
              <span class="destination-card__line"><span>1</span>{t('Gradska linija', 'City line')}</span>
              <span class="destination-card__area">{t('Trapisti', 'Trapisti')}</span>
            </div>
            <h3>{t('Trapisti i samostan Marija Zvijezda', 'Trapisti and the Marija Zvijezda Monastery')}</h3>
            <p>
              {t(
                'Trapisti su kraj koji vrijedi obići polako: samostan, pivara, stara hidrocentrala i staza uz Vrbas nalaze se na istom potezu. Ime je dobio po monasima koji su se ovdje naselili krajem 19. vijeka.',
                'Trapisti is best explored at an unhurried pace: the monastery, brewery, old power station and Vrbas trail all sit along the same stretch. The neighbourhood takes its name from the monks who settled here in the late 19th century.',
              )}
            </p>
            <ul class="destination-card__places">
              {trapistiPlaces.map((place) => (
                <li>
                  <i class="fa-solid fa-check" aria-hidden="true"></i>
                  <span>
                    <strong>
                      {place.href ? (
                        <a href={place.href} target="_blank" rel="noopener noreferrer">
                          {place.label}
                          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                      ) : (
                        place.label
                      )}
                    </strong>
                    <small>{place.note}</small>
                  </span>
                </li>
              ))}
            </ul>
            <div class="destination-card__transit">
              <p class="destination-card__transit-title">
                <i class="fa-solid fa-bus" aria-hidden="true"></i>{t('Kako doći', 'Getting there')}
              </p>
              <dl class="destination-card__trip">
                <div><dt>{t('Smjer', 'Direction')}</dt><dd>{t('Mađir', 'Mađir')}</dd></div>
                <div><dt>{t('Stajalište', 'Stop')}</dt><dd>{t('Pivara', 'Pivara')}</dd></div>
              </dl>
              <p class="destination-card__transit-note">
                {t(
                  'Izađite kod Pivare; odatle su znamenitosti i staza nadohvat pješice.',
                  'Get off at Pivara; the sights and trail are a short walk from there.',
                )}
              </p>
              <a href={linePath('1')} class="destination-card__link">{t('Otvori liniju 1', 'Open line 1')}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </article>

        <article class="destination-card">
          <figure class="destination-card__media">
            <img
              src={withBase('/assets/images/tourism/banj-bus.jpg')}
              alt={t('Banj Bus na putu prema Banj brdu', 'Banj Bus on the road to Banj Hill')}
              width={678}
              height={452}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="explore-credit">{credit('banjaluka.rs.ba')}</figcaption>
          </figure>
          <div class="destination-card__body">
            <div class="destination-card__topline">
              <span class="destination-card__service"><i class:list={['fa-solid', destinationIcons.banjBrdo]} aria-hidden="true"></i>Banj Bus</span>
              <span class="destination-card__area">{t('Izletište', 'Day trip')}</span>
            </div>
            <h3>{t('Banj brdo', 'Banj Hill')}</h3>
            <p>
              {t(
                'Kada želite pogled iznad grada, krenite na Banj brdo. Na vrhu vas čekaju spomenik palim borcima Krajine, djelo kipara Antuna Augustinčića, pogled prema gradu i dolini Vrbasa, te staze kroz šumu. Jedna od njih vodi prema Šeheru, odnosno banji Terme Banja Luka.',
                'For a view above the city, head for Banj Hill. At the top you’ll find the memorial to the fallen fighters of Krajina by sculptor Antun Augustinčić, views over the city and Vrbas valley, and woodland trails. One of them leads towards Šeher and the Terme Banja Luka spa.',
              )}
            </p>
            <div class="destination-card__transit">
              <p class="destination-card__transit-title">
                <i class="fa-solid fa-bus" aria-hidden="true"></i>{t('Kako doći', 'Getting there')}
              </p>
              <dl class="destination-card__trip">
                <div><dt>{t('Polazak', 'Board at')}</dt><dd>TO Bema</dd></div>
                <div><dt>{t('Vozi', 'Runs')}</dt><dd>{t('sezonski', 'seasonally')}</dd></div>
              </dl>
              <p class="destination-card__transit-note">
                {t(
                  'Do Banj brda ne vozi gradska linija, nego poseban Banj Bus. Provjerite dane vožnje i polaske prije puta. Ako ste za uspon, do vrha vode i staze iz grada.',
                  'Banj Hill is served by a separate Banj Bus, not a city line. Check the operating days and departures before you travel. If you prefer the climb, trails from town lead to the top.',
                )}
              </p>
              <a href={banjBusUrl} class="destination-card__link" target="_blank" rel="noopener noreferrer">
                {t('Provjeri Banj Bus', 'Check Banj Bus')}<i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </article>

        <article class="destination-card">
          <figure class="destination-card__media">
            <img
              src={withBase('/assets/images/tourism/plaza-vrucica.jpg')}
              alt={t('Plaža Vrućica na Vrbasu', 'Vrućica Beach on the Vrbas')}
              width={2048}
              height={1366}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="explore-credit">{credit('banjaluka.rs.ba')}</figcaption>
          </figure>
          <div class="destination-card__body">
            <div class="destination-card__topline">
              <span class="destination-card__line"><span>9</span>{t('Gradska linija', 'City line')}</span>
              <span class="destination-card__area">{t('Srpske Toplice', 'Srpske Toplice')}</span>
            </div>
            <h3>{t('Plaža Vrućica', 'Vrućica Beach')}</h3>
            <p>
              {t(
                'Vrućica je gradska plaža uz Vrbas, u Šeheru - kraju poznatom po termomineralnim izvorima. Ljeti se ovdje dolazi po osvježenje, a uz rijeku je lijepo svratiti i kada nema kupanja.',
                'Vrućica is the city beach on the Vrbas in Šeher, a neighbourhood known for thermal-mineral springs. Come here for a summer swim, or simply a riverside stop when swimming is off the agenda.',
              )}
            </p>
            <div class="destination-card__transit">
              <p class="destination-card__transit-title">
                <i class="fa-solid fa-bus" aria-hidden="true"></i>{t('Kako doći', 'Getting there')}
              </p>
              <dl class="destination-card__trip">
                <div><dt>{t('Smjer', 'Direction')}</dt><dd>{t('Desna Novoselija', 'Desna Novoselija')}</dd></div>
                <div><dt>{t('Stajalište', 'Stop')}</dt><dd>{t('MZ Srpske Toplice', 'MZ Srpske Toplice')}</dd></div>
              </dl>
              <a href={linePath('9')} class="destination-card__link">{t('Otvori liniju 9', 'Open line 9')}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </article>

        <article class="destination-card">
          <div class="destination-card__media destination-card__media--pair">
            <figure class="destination-card__shot">
              <img
                src={withBase('/assets/images/tourism/univerzitetski-kampus.jpg')}
                alt={t(
                  'Drvored na Univerzitetskom kampusu u Banjoj Luci u jesen',
                  'Tree-lined avenue on the University Campus in Banja Luka in autumn',
                )}
                width={1200}
                height={800}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="explore-credit">{credit('Saša Knežić')}</figcaption>
            </figure>
            <figure class="destination-card__shot">
              <img
                src={withBase('/assets/images/tourism/botanicka-basta.jpg')}
                alt={t(
                  'Staza i klupa u Botaničkoj bašti Univerziteta u Banjoj Luci',
                  'Path and bench in the Botanical Garden of the University of Banja Luka',
                )}
                width={1200}
                height={800}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="explore-credit">{credit('mondo.ba - Slaven Petković')}</figcaption>
            </figure>
          </div>
          <div class="destination-card__body">
            <div class="destination-card__topline">
              <span class="destination-card__service"><i class:list={['fa-solid', destinationIcons.kampus]} aria-hidden="true"></i>{t('Kampus', 'Campus')}</span>
              <span class="destination-card__area">Borik</span>
            </div>
            <h3>
              <a href={universityUrl} target="_blank" rel="noopener noreferrer">
                {t('Botanička bašta i Univerzitetski kampus', 'Botanical Garden and University Campus')}
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              </a>
            </h3>
            <p>
              {t(
                'Botanička bašta je miran dio Kampusa za šetnju među drvećem, cvijećem i više od 1.500 biljnih vrsta. Potražite ginko, Pančićevu omoriku ili japansku magnoliju, pa produžite kroz Univerzitetski kampus.',
                'The Botanical Garden is a quiet corner of the campus for a walk among trees, flowers and more than 1,500 plant species. Look out for ginkgo, Serbian spruce and Japanese magnolia, then continue through the University Campus.',
              )}
            </p>
            <div class="destination-card__transit">
              <p class="destination-card__transit-title">
                <i class="fa-solid fa-bus" aria-hidden="true"></i>{t('Kako doći', 'Getting there')}
              </p>
              <dl class="destination-card__trip">
                <div><dt>{t('Stajališta', 'Stops')}</dt><dd>{t('Kampus, Dvorana Borik, Borik ili Autoservis', 'Kampus, Dvorana Borik, Borik, or Autoservis')}</dd></div>
              </dl>
              <p class="destination-card__transit-note">
                {t(
                  'Linija 20 staje na ulazu u Kampus. Sa stajališta linija 14B, 14 i 9B do bašte i kampusa treba tek nekoliko minuta hoda.',
                  'Line 20 stops at the campus entrance. From the nearby stops served by 14B, 14 and 9B, the garden and campus are only a few minutes on foot.',
                )}
              </p>
              <div class="destination-card__line-links" aria-label={t('Linije u blizini', 'Nearby lines')}>
                <a href={linePath('20')}>20</a>
                <a href={linePath('14B')}>14B</a>
                <a href={linePath('14')}>14</a>
                <a href={linePath('9B')}>9B</a>
              </div>
            </div>
          </div>
        </article>

        <article class="destination-card">
          <figure class="destination-card__media">
            <img
              src={withBase('/assets/images/tourism/park-restoran-stara-ada.jpg')}
              alt={t(
                'Park restoran Stara Ada uz Vrbas, sa šetnicom pored rijeke',
                'Stara Ada park restaurant beside the Vrbas, with a riverside promenade',
              )}
              width={1200}
              height={800}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="explore-credit">{credit('Leon Bijelić')}</figcaption>
          </figure>
          <div class="destination-card__body">
            <div class="destination-card__topline">
              <span class="destination-card__line"><span>20</span>{t('Gradska linija', 'City line')}</span>
              <span class="destination-card__area">Ada</span>
            </div>
            <h3>{t('Park restoran Stara Ada', 'Stara Ada Park Restaurant')}</h3>
            <p>
              {t(
                'Na Staroj Adi možete sjesti uz Vrbas, prošetati kraj rijeke i napraviti pauzu za ručak ili kafu. Dovoljno je blizu da se uklopi u običan dan, a dovoljno mirno da predahnete od gradske gužve.',
                'At Stara Ada, sit by the Vrbas, walk beside the river and stop for lunch or coffee. It is close enough to fit into an ordinary day, yet quiet enough for a break from the city bustle.',
              )}
            </p>
            <div class="destination-card__transit">
              <p class="destination-card__transit-title">
                <i class="fa-solid fa-bus" aria-hidden="true"></i>{t('Kako doći', 'Getting there')}
              </p>
              <dl class="destination-card__trip">
                <div><dt>{t('Smjer', 'Direction')}</dt><dd>Incel</dd></div>
                <div><dt>{t('Stajalište', 'Stop')}</dt><dd>Ada</dd></div>
              </dl>
              <a href={linePath('20')} class="destination-card__link">{t('Otvori liniju 20', 'Open line 20')}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section explore-plan" aria-labelledby="explore-plan-title">
    <div class="container explore-plan__card">
      <div>
        <p class="explore-eyebrow">{t('Prije nego krenete', 'Before you go')}</p>
        <h2 id="explore-plan-title">{t('Dva minuta pripreme, mirniji put', 'Two minutes of planning, an easier trip')}</h2>
        <p>
          {t(
            'Polasci i trajanje vožnje mogu se promijeniti, a Banj Bus vozi sezonski. Zato neposredno prije puta provjerite liniju, smjer i mapu stajališta.',
            'Departures and journey times can change, and Banj Bus is seasonal. Before setting off, check the route, direction and stop map.',
          )}
        </p>
      </div>
      <div class="explore-plan__links">
        <a href={guidePath}><i class="fa-solid fa-book-open" aria-hidden="true"></i>{t('Vodič za putnike', 'Passenger guide')}</a>
        <a href={mapPath}><i class="fa-solid fa-map" aria-hidden="true"></i>{t('Mapa stajališta', 'Stop map')}</a>
        <a href={pricingPath}><i class="fa-solid fa-ticket" aria-hidden="true"></i>{t('Karte i cijene', 'Tickets and prices')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
