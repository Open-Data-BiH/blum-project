---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getAlternatePaths, getLocalizedMeta, getPagePath, getSwitchLocale, type Locale } from '../../lib/site-config';
import faqData from '../../../public/data/transport/faq.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allQuestions = faqData.categories.flatMap((cat) => cat.questions);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allQuestions.map((q) => ({
    '@type': 'Question',
    name: q.question[locale],
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer[locale],
    },
  })),
};
const meta = getLocalizedMeta('faq', locale);
const alternatePaths = getAlternatePaths('faq');
---

<BaseLayout
  pageKey="faq"
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={getPagePath('faq', locale)}
  alternatePaths={alternatePaths}
  switchLanguagePath={getPagePath('faq', getSwitchLocale(locale))}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <PageIntro
    title={locale === 'en' ? 'Banja Luka public transport FAQ' : 'Česta pitanja o javnom prevozu'}
    description={locale === 'en'
      ? 'Answers to common questions about public transport in Banja Luka.'
      : 'Odgovori na najčešća pitanja o javnom prevozu u Banjoj Luci.'}
    titleId="faq-title"
    icon="fa-solid fa-circle-question"
  />

  <section class="section section--narrow" id="faq">
    <div class="container">
      <FAQSection locale={locale} />
    </div>
  </section>
</BaseLayout>
