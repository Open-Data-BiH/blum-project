---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingSection from '../../components/PricingSection.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getAlternatePaths, getLocalizedMeta, getPagePath, getSwitchLocale, type Locale } from '../../lib/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = getLocalizedMeta('pricing', locale);
const alternatePaths = getAlternatePaths('pricing');
const isEnglish = locale === 'en';
---

<BaseLayout
  pageKey="pricing"
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={getPagePath('pricing', locale)}
  alternatePaths={alternatePaths}
  switchLanguagePath={getPagePath('pricing', getSwitchLocale(locale))}
>
  <PageIntro
    title={locale === 'en' ? 'Ticket prices' : 'Cjenovnik karata'}
    description={isEnglish
      ? 'Compare single, daily, and monthly public transport ticket prices.'
      : 'Uporedite cijene pojedinačnih, dnevnih i mjesečnih karata za javni prevoz.'}
    titleId="price-tables-title"
    icon="fa-solid fa-ticket"
  />

  <section class="section pricing-hero" id="pricing">
    <div class="container">
      <div class="pricing-main">
        <PricingSection locale={locale} />
      </div>
    </div>
  </section>

  <section class="section pricing-section pricing-section--info" id="where-to-buy">
    <div class="pricing-section__inner">
      {isEnglish ? (
        <div class="pricing-info-block">
          <h2 class="pricing-section__title">Where to Buy Tickets</h2>
          <div class="pricing-info-grid pricing-info-grid--two">
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Single and Day Tickets</h3>
              <ul class="pricing-info-list">
                <li><strong>Single tickets</strong> and <strong>sets of 5 single tickets</strong> - available on the bus, with cash payment to the driver when boarding, or at operator sales points</li>
                <li><strong>Day tickets</strong> - available at operator sales points</li>
              </ul>
            </div>
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Monthly Tickets</h3>
              <ul class="pricing-info-list">
                <li>Worker, pensioner, and student monthly tickets - available <strong>at operator sales points only</strong></li>
                <li>Unified monthly card (JMK) - valid on all urban lines across all three operators</li>
                <li>Supplement card - combined with a suburban zone ticket, valid on all urban lines too</li>
              </ul>
            </div>
          </div>
        </div>
      ) : (
        <div class="pricing-info-block">
          <h2 class="pricing-section__title">Gdje kupiti kartu</h2>
          <div class="pricing-info-grid pricing-info-grid--two">
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Pojedinačne i dnevne karte</h3>
              <ul class="pricing-info-list">
                <li><strong>Pojedinačna karta</strong> i <strong>blok od 5 pojedinačnih karata</strong> – kupovina u autobusu, uz plaćanje gotovinom vozaču pri ulasku, ili na prodajnim mjestima prevoznika</li>
                <li><strong>Dnevna karta</strong> – kupovina na prodajnim mjestima prevoznika</li>
              </ul>
            </div>
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Mjesečne karte</h3>
              <ul class="pricing-info-list">
                <li>Radnička, penzionerska i đačka karta - isključivo na <strong>prodajnim mjestima prevoznika</strong></li>
                <li>Jedinstvena mjesečna karta (JMK) - važi na svim gradskim linijama sva tri prevoznika</li>
                <li>Doplatna karta - uz zonsku prigradsku kartu, važi i na gradskim linijama</li>
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section pricing-section pricing-section--concessions" id="free-travel-discounts">
    <div class="pricing-section__inner">
      {isEnglish ? (
        <div class="pricing-info-block">
          <h2 class="pricing-section__title">Free Travel &amp; Discounts</h2>
          <div class="pricing-info-grid pricing-info-grid--two">
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Free Travel</h3>
              <ul class="pricing-info-list">
                <li><strong>Existing:</strong> parents of fallen soldiers; blind persons with a companion</li>
                <li><strong>From 2024:</strong> pensioners and persons over 65 with Banja Luka residency; students from large families (4+); JU Dom "Rada Vranješević" residents; children in foster care</li>
              </ul>
            </div>
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Discounts</h3>
              <ul class="pricing-info-list">
                <li>Children of fallen soldiers (secondary school and university) and their non-pensioner, non-disabled (cat. I/II) spouses</li>
                <li>Student subsidies for urban and suburban lines</li>
              </ul>
            </div>
          </div>
          <div class="pricing-notice">
            <p>To apply for free travel or a discount, contact the competent institutions with the required documentation.</p>
          </div>
        </div>
      ) : (
        <div class="pricing-info-block">
          <h2 class="pricing-section__title">Besplatna vožnja i popusti</h2>
          <div class="pricing-info-grid pricing-info-grid--two">
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Besplatna vožnja</h3>
              <ul class="pricing-info-list">
                <li><strong>Postojeće:</strong> roditelji poginulih boraca; slijepa lica sa pratiocem</li>
                <li><strong>Od 2024.:</strong> penzioneri i lica starija od 65 godina s prebivalištem u Banjoj Luci; učenici i studenti iz višečlanih porodica (4+); korisnici JU Dom „Rada Vranješević"; djeca iz hraniteljskih porodica</li>
              </ul>
            </div>
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Popusti</h3>
              <ul class="pricing-info-list">
                <li>Djeca poginulih boraca (srednja škola i fakultet) i supruge poginulih boraca koje nisu penzioneri ni invalidi I/II kategorije</li>
                <li>Učenici i studenti (subvencije za gradske i prigradske linije)</li>
              </ul>
            </div>
          </div>
          <div class="pricing-notice">
            <p>Za ostvarivanje prava na besplatan prevoz ili popust obratite se nadležnim institucijama uz potrebnu dokumentaciju.</p>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section pricing-section pricing-section--rules" id="ticket-inspection">
    <div class="pricing-section__inner">
      {isEnglish ? (
        <div class="pricing-info-block">
          <h2 class="pricing-section__title">Ticket Inspection Rules</h2>
          <div class="pricing-info-grid pricing-info-grid--two">
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Passenger Obligations</h3>
              <ul class="pricing-info-list">
                <li>Every passenger must hold a <strong>valid ticket</strong> for the entire journey.</li>
                <li>Upon request from an authorised inspector, passengers must <strong>present their ticket</strong>.</li>
                <li>Inspectors are authorised personnel and have the right to check tickets at any point during the journey.</li>
              </ul>
            </div>
            <div class="pricing-info-card pricing-info-card--expanded">
              <h3 class="pricing-info-card__title">Notes</h3>
              <ul class="pricing-info-list">
                <li>Tickets purchased on the bus are valid for that journey only and are non-transferable.</li>
                <li>Tickets are not valid across different line groups (e.g. urban and suburban lines).</li>
                <li>If you have an issue during an inspection, report it to the city inspection authority.</li>
              </ul>
            </div>
          </div>
        </div>
      ) : (
        <div class="pricing-info-block">
        <h2 class="pricing-section__title">Pravila kontrole karata</h2>
        <div class="pricing-info-grid pricing-info-grid--two">
          <div class="pricing-info-card pricing-info-card--expanded">
            <h3 class="pricing-info-card__title">Obaveze putnika</h3>
            <ul class="pricing-info-list">
              <li>Svaki putnik mora imati <strong>važeću kartu</strong> za cijelo trajanje vožnje.</li>
              <li>Na zahtjev ovlaštenog kontrolora obavezno je <strong>pokazati kartu</strong>.</li>
              <li>Kontrolori su ovlaštena lica i imaju pravo provjere karata u bilo kom trenutku tokom vožnje.</li>
            </ul>
          </div>
          <div class="pricing-info-card pricing-info-card--expanded">
            <h3 class="pricing-info-card__title">Napomene</h3>
            <ul class="pricing-info-list">
              <li>Karte kupljene u autobusu vrijede samo za tu vožnju i nisu prenosive.</li>
              <li>Karte nisu prenosive između različitih grupa linija (npr. gradske i prigradske linije).</li>
              <li>U slučaju problema s kontrolom, prijavite situaciju nadležnoj gradskoj inspekciji.</li>
            </ul>
          </div>
        </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-hero {
    padding-bottom: var(--space-16);
  }

  .pricing-main {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }

  .pricing-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .pricing-section__inner {
    width: 100%;
    max-width: calc(960px + var(--layout-gutter) + var(--layout-gutter));
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  .pricing-info-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .pricing-section + .pricing-section .pricing-section__inner {
    padding-top: var(--space-10);
    border-top: 1px solid var(--border-subtle);
  }

  .pricing-section--rules {
    padding-bottom: var(--space-20);
  }

  .pricing-section__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin: 0;
  }

  .pricing-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
  }

  .pricing-info-grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .pricing-info-card {
    background-color: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: none;
  }

  .pricing-info-card--expanded {
    padding: var(--space-8) var(--space-10);
  }

  .pricing-info-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .pricing-info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pricing-info-list li {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
    padding-left: var(--space-5);
    position: relative;
  }

  .pricing-info-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    position: absolute;
    left: 0;
    top: 0.55em;
  }

  .pricing-info-list strong {
    color: var(--text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .pricing-notice {
    margin-top: var(--space-4);
    background-color: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
    box-shadow: none;
  }

  .pricing-notice p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .pricing-section--rules .pricing-info-grid {
    gap: 0;
  }

  .pricing-section--rules .pricing-info-card {
    padding: 0 var(--space-8) 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .pricing-section--rules .pricing-info-card + .pricing-info-card {
    padding-right: 0;
    padding-left: var(--space-8);
    border-left: 1px solid var(--border-subtle);
  }

  .pricing-section--rules .pricing-info-list li::before {
    background-color: var(--text-light);
  }

  @media (max-width: 1024px) {
    .pricing-info-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .pricing-section + .pricing-section .pricing-section__inner {
      padding-top: var(--space-8);
    }

    .pricing-section__title {
      font-size: var(--font-size-xl);
    }

    .pricing-info-grid,
    .pricing-info-grid--two {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .pricing-info-card {
      padding: var(--space-5) var(--space-6);
    }

    .pricing-info-card--expanded {
      padding: var(--space-6) var(--space-8);
    }

    .pricing-section--rules .pricing-info-card {
      padding: 0;
    }

    .pricing-section--rules .pricing-info-card + .pricing-info-card {
      margin-top: var(--space-6);
      padding: var(--space-6) 0 0;
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
    }
  }

  @media (max-width: 600px) {
    .pricing-hero {
      padding-bottom: var(--space-16);
    }

    .pricing-section {
      padding-bottom: var(--space-6);
    }
  }
</style>
